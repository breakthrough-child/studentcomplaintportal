# Placeholders only. Copy to .env.local (never commit .env.local).

# Supabase project URL and the public (anon / publishable) key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never import from client components.
# Used solely by trusted server code (admin invitations, storage purge job).
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for auth e-mail redirect links (password reset / invitations).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upload limits live in the database (public.app_settings) and are editable by admins.
# Keep the storage bucket's file_size_limit in step with max_attachment_size_bytes.
