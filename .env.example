# Placeholders only. Copy to .env.local (never commit .env.local).

# Supabase project URL and the public (anon / publishable) key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never import from client components.
# Used by trusted server code only: admin invitations and sending queued notification e-mails.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for auth e-mail redirect links and the links in notification e-mails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Outgoing e-mail for lecturer notifications (SMTP). Leave SMTP_HOST empty to keep e-mails queued.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<address>, SMTP_PASSWORD=<16-character app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Student Complaint Portal <no-reply@example.edu>

# Optional: protects GET /api/notifications/send (scheduled retry of queued e-mails). At least 24 characters.
CRON_SECRET=
